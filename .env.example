# Copy to .env and fill in from Firebase Console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise site key). See README "App Check".
VITE_RECAPTCHA_SITE_KEY=
# Development only: debug token from Firebase Console > App Check > Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=
